# Copy to .env and fill in. NEVER commit .env.
# Defaults are SAFE: dry-run on, paid calls off, publishing off.

# --- Safety switches ------------------------------------------------------
DRY_RUN=true                 # true = no network provider calls at all
ALLOW_PAID_CALLS=false       # must be true (and DRY_RUN=false) before any paid provider runs
X_PUBLISH_ENABLED=false      # must be true (and DRY_RUN=false) before anything is posted to X

# --- Budget ceilings (USD) ------------------------------------------------
# Per-job defaults. A job may request less, never more than the project ceiling.
JOB_BUDGET_TEXT_USD=0
JOB_BUDGET_IMAGE_USD=5
JOB_BUDGET_VIDEO_USD=75
# Project-wide ceilings, summed over every job in the ledger.
PROJECT_BUDGET_TEXT_USD=0
PROJECT_BUDGET_IMAGE_USD=5
PROJECT_BUDGET_VIDEO_USD=75

# --- Language model (optional) -------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EST_COST_PER_CALL_USD=0.002
# Image generation (optional, same key)
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_EST_COST_PER_IMAGE_USD=0.07

# --- X / Twitter (OAuth 1.0a user context) -------------------------------
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
X_EST_COST_PER_POST_USD=0

# --- Higgsfield video (image-to-video) ------------------------------------
# Get key + secret from Higgsfield's developer console. Model path from their API catalog
# (e.g. the Seedance or Kling image-to-video path), without a leading slash.
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_SECRET=
HIGGSFIELD_BASE_URL=https://platform.higgsfield.ai
HIGGSFIELD_VIDEO_MODEL=
HIGGSFIELD_EXTRA_PARAMS={}       # JSON merged into each request, e.g. {"resolution":"720p"}
HIGGSFIELD_POLL_SECONDS=10
HIGGSFIELD_TIMEOUT_MINUTES=20
# Set this to your real per-second price so the budget gate is accurate. Over-estimate, never under.
VIDEO_EST_COST_PER_SECOND_USD=0.5
# Public URL of the approved Nami start frame (used for any shot without its own startFrameUrl).
NAMI_REFERENCE_IMAGE_URL=

# --- Fee wallet (PUBLIC address only) ------------------------------------
# Public Solana address where creator/platform fees should be paid.
# Do NOT put a private key or seed phrase here; this engine never signs transactions.
SOLANA_FEE_WALLET_ADDRESS=

# --- Funding gate: fees received unlock the render budget -----------------
# Read-only balance polling of the address above. Use a wallet dedicated to fees.
FUNDING_WATCH_ENABLED=false
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com   # free public RPC; Helius/QuickNode free tier is more reliable
SOL_PRICE_SOURCE=coingecko       # coingecko | fixed
SOL_USD_PRICE=                   # fallback / fixed price
FUNDING_COUNT_EXISTING_BALANCE=true
FUNDING_VIDEO_PCT=80             # % of received USD unlocked for video
FUNDING_IMAGE_PCT=10             # % for images; the rest is never auto-spent

# --- Autopilot: renders armed jobs as soon as budget is unlocked ----------
AUTOPILOT_ENABLED=false
AUTOPILOT_INTERVAL_SECONDS=60
AUTOPILOT_REQUIRE_PILOT_APPROVAL=true
AUTOPILOT_MAX_RETRIES=3
PROGRESS_SHOW_PREVIEWS=false     # true = website can play finished clips before the final cut

# --- Server ---------------------------------------------------------------
HOST=127.0.0.1
PORT=8787
ADMIN_TOKEN=                 # required for any write endpoint; long random string
CORS_ORIGIN=*                # origin allowed to read /api/feed
DATA_DIR=./data
# Optional: also write the feed here so the static site can read it, e.g. ../public/data/feed.json
FEED_EXPORT_PATH=
PUBLIC_BASE_URL=http://127.0.0.1:8787
